class Solution {
  public:
    string twosComplement(string s) {
        for(int i = 0;i<s.size();++i){
            if(s[i] == '0')s[i] = '1';
            else s[i] = '0';
        }
        int carry = 1;
        for(int i = s.size()-1;i>=0;--i){
            int sum = carry +  (s[i] - '0');
            carry = sum/2;
            int re = sum % 2;
            s[i] = re + '0';
        }
        return s;
    }
};
